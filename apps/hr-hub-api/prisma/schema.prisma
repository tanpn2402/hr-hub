generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Attendance {
  id String @id @default(cuid())

  employeeCode String
  employeeName String?

  date DateTime

  checkIn  DateTime?
  checkOut DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode, date])
  @@index([date])
}

model Leave {
  id String @id @default(cuid())

  employeeCode String
  employeeName String?

  date DateTime

  type   String
  reason String?

  status String @default("approved")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode, date])
  @@index([employeeCode, status])
  @@index([date])
}

model Fine {
  id String @id @default(cuid())

  employeeCode String
  employeeName String?

  date DateTime

  // Original amount imported/calculated from attendance data.
  // This value should never be changed after creation.
  amount Int

  // Current payable amount after approved feedback reductions.
  // null means no adjustment has been applied.
  adjustedAmount Int?

  currency String @default("VND")

  type   String
  reason String?

  // unpaid / paid / cancelled
  status String @default("unpaid")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode, date])
  @@index([employeeCode, status])
  @@index([date])
}

model FineFeedback {
  id String @id @default(cuid())

  fineId String

  employeeCode String
  employeeName String?

  // early_leave_permission
  // late_permission
  // wrong_time
  // wrong_fine
  // other
  reason String

  description String?

  // pending / approved / rejected
  status String @default("pending")

  // Amount actually reduced from the fine when approved.
  reductionAmount Int?

  reviewedBy     String?
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fineId])
  @@index([employeeCode, status])
}

model WorkforceImport {
  id String @id @default(cuid())

  month              String?
  status             String    @default("preview")
  attendanceFileName String
  leaveFileName      String
  totalAttendance    Int       @default(0)
  totalLeave         Int       @default(0)
  totalFine          Int       @default(0)
  previewData        String?
  createdBy          String?
  createdByName      String?
  confirmedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model WorkforceRule {
  id String @id @default(cuid())

  /// BASE is reserved for future DB-based base rules.
  /// OVERRIDE represents an HR-defined exception.
  kind String @default("OVERRIDE")

  /// Property being overridden.
  /// Examples:
  /// AFTERNOON_CHECKOUT_DEADLINE
  /// MORNING_START
  /// CHECKIN_REQUIRED
  /// CHECKOUT_REQUIRED
  /// FINE_LATE_MORNING
  /// WORKING_DAY
  property String

  /// Serialized value.
  /// Time properties: HH:mm
  /// Fine properties: numeric string
  /// Boolean properties: "true"/"false"
  value String

  /// null = all employees
  employeeCode String?

  /// null = every weekday/date
  weekday Int?

  /// Inclusive date range.
  /// startDate == endDate means one specific date.
  startDate DateTime?
  endDate   DateTime?

  /// Higher priority wins when multiple rules match.
  priority Int @default(0)

  reason String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode, enabled])
  @@index([startDate, endDate, enabled])
  @@index([property, enabled])
}

model EmployeeMonthlyFine {
  id String @id @default(cuid())

  employeeCode String
  employeeName String?

  /// First day of the month, e.g. 2026-09-01
  month DateTime

  /// Total of Fine.amount for this employee/month.
  originalAmount Int @default(0)

  /// Total approved reductions from FineFeedback.
  reductionAmount Int @default(0)

  /// Amount that the employee actually needs to pay.
  /// Usually:
  /// originalAmount - reductionAmount
  payableAmount Int @default(0)

  currency String @default("VND")

  /// pending / completed / cancelled
  status String @default("pending")

  /// Optional: when this monthly fine was paid.
  paidAt DateTime?

  /// User/system that confirmed the payment.
  paidBy     String?
  paidByName String?

  /// Optional note about the monthly settlement.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeCode, month])
  @@index([month, status])
  @@index([employeeCode, status])
}

model FinePayment {
  id String @id @default(cuid())

  employeeCode String
  employeeName String?

  /// Monthly fine IDs included in this payment.
  /// JSON array of EmployeeMonthlyFine.id values.
  monthlyFineIds String

  /// Total amount being paid.
  amount Int

  currency String @default("VND")

  /// pending / paid / cancelled / expired
  status String @default("pending")

  /// qr / bank_transfer / cash
  paymentMethod String?

  /// APIPAY / PAYOS / ...
  provider String?

  /// Provider order/payment ID.
  providerPaymentId String?

  providerMetadata String?

  paidAt DateTime?

  createdBy     String?
  createdByName String?

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode, status])
  @@index([status])
  @@index([providerPaymentId])
}

model FinancialTransaction {
  id String @id @default(cuid())

  transactionDate DateTime

  // fine_payment / reimbursement / refund / salary_adjustment / ...
  type String

  // income / expense
  direction String

  amount   Int
  currency String @default("VND")

  // Generic reference to the business record.
  // Example:
  // type = "fine_payment"
  // referenceId = Fine.id
  referenceId String?

  // User/system that created the transaction.
  createdBy     String?
  createdByName String?

  category    String?
  description String?

  // APIPAY / PAYOS / ...
  provider         String?
  // JSON string for provider-specific information.
  providerMetadata String?

  // qr / bank_transfer / cash / ...
  paymentMethod String?

  // pending / completed / cancelled / refunded
  status String @default("pending")

  metadata String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referenceId])
  @@index([type, referenceId])
  @@index([status])
  @@index([transactionDate])
}
