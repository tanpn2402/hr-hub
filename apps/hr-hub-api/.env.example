SERVER_PORT=3000

# CORS
CORS_ENABLED=Y
CORS_ORIGIN=http://localhost:5174

# Idenplane authentication
IDENPLANE_URL=http://localhost:3004
IDENPLANE_REALM=tts
IDENPLANE_CLIENT_ID=hr-hub-1
# Required only when the Idenplane client is confidential. (hr-hub is Public)
IDENPLANE_CLIENT_SECRET=
IDENPLANE_HTTP_TIMEOUT_MS=10000

# Workforce Excel uploads
WORKFORCE_UPLOAD_DIR=./uploads/workforce

# Late-fine business rules (see modules/workforce/models/workforce-rules.model.ts)
# Weekday labels as printed in the attendance file; fines only apply on these days
WORKFORCE_WORKDAYS=Hai,Ba,Tư,Năm,Sáu
# Compensatory workdays ("ngày làm bù") that also require attendance even though they fall on
# an off-day (e.g. a Saturday make-up for a holiday). Format: DD-MM-YYYY, comma-separated list.
# Example: WORKFORCE_MAKEUP_WORKDAYS=22-08-2026,05-09-2026
WORKFORCE_MAKEUP_WORKDAYS=
# Employee codes (Mã NV) to exclude entirely from the report - e.g. staff who have since left
# the company. Comma-separated list. Example: WORKFORCE_EXCLUDED_EMPLOYEES=00009,584
WORKFORCE_EXCLUDED_EMPLOYEES=
WORKFORCE_MORNING_START=08:30
WORKFORCE_MORNING_END=11:30
WORKFORCE_MORNING_CHECKOUT_DEADLINE=11:29
WORKFORCE_AFTERNOON_START=13:00
WORKFORCE_AFTERNOON_CHECKOUT_DEADLINE=17:15
WORKFORCE_LEAVE_DAY_START=08:00
WORKFORCE_LEAVE_DAY_END=17:30
WORKFORCE_FINE_LATE_MORNING=30000
WORKFORCE_FINE_LATE_AFTERNOON=30000
WORKFORCE_FINE_NO_CHECKOUT_HALF_DAY=10000
WORKFORCE_FINE_NO_CHECKOUT_FULL_DAY=10000

# Per-employee rule overrides: list the employee codes here, then define `<Mã NV>_<ENV_KEY>`
# for any of the WORKFORCE_* time/fine keys above to override it just for that employee.
# Example:
# WORKFORCE_OVERRIDE_RULE_EMPLOYEES=550
# 550_WORKFORCE_MORNING_START=08:00
# 550_WORKFORCE_AFTERNOON_CHECKOUT_DEADLINE=16:15
WORKFORCE_OVERRIDE_RULE_EMPLOYEES=

# Logging
LOGGER_TRANSPORTS=console,file
LOGGER_FILE_DIRNAME=./logs
LOGGER_FILE_NAME=application
LOGGER_FILE_LEVEL=info
LOGGER_FILE_MAX_SIZE=10m
LOGGER_FILE_ZIPPED_ARCHIVE=N

# Apipay
PAYMENT_PROVIDER=APIPAY
APIPAY_HOST=https://api.apipay.vn
APIPAY_ACCESS_KEY=
APIPAY_SECRET_KEY=
APIPAY_BANK_PUBLIC_ID=
APIPAY_HTTP_TIMEOUT_MS=10000
APIPAY_QR_EXPIRES_IN_SECONDS=300
